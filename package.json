{
  "name": "minecraft-ai-companion",
  "version": "1.0.0",
  "description": "Local-first Minecraft companion powered by Mineflayer and Ollama",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "check": "node scripts/check-syntax.js",
    "test": "node test/run.js",
    "smoke:learning": "node scripts/smoke-learning-ollama.js --count=1",
    "reliability:learning": "node scripts/smoke-learning-ollama.js --count=20",
    "coherence:learning": "node scripts/test-learning-coherence.js --count=10",
    "simulate:learning": "node scripts/simulate-learning-episode.js",
    "benchmark:vision": "node benchmark/vision/run.js",
    "diagnose:ollama": "node scripts/diagnose-ollama-response.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5"
  }
}
