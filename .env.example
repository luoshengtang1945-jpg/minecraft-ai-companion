# Minecraft LAN/server connection (MC_PORT is intentionally required)
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=AI_Companion
MC_AUTH=offline
MC_VERSION=1.21.11

# Local Ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_RESPONSE_RETRIES=2
OLLAMA_RETRY_BACKOFF_MS=250
# Recommended false for qwen3-vl decision latency. The client safely normalizes its validated compatibility channel.
OLLAMA_THINK=false
# Logs response metadata; when true, also logs truncated raw content/thinking for local debugging.
OLLAMA_DEBUG=false
OLLAMA_DEBUG_RAW_MAX_CHARS=2000

# Survival and combat tuning
COMBAT_MODE=DEFENSIVE
SURVIVAL_TICK_MS=150
HOSTILE_DETECTION_RANGE=10
PLAYER_DEFENSE_RANGE=8
IMMEDIATE_DANGER_RANGE=3.5
DEFENSE_MEMORY_MS=5000
ATTACK_ORDER_MS=15000
COMBAT_MAX_PURSUIT_MS=8000
COMBAT_MAX_PURSUIT_DISTANCE=6
COMBAT_PLAYER_LEASH=8
COMBAT_PURSUIT_COOLDOWN_MS=10000
LOW_HEALTH_THRESHOLD=8
SAFE_HEALTH_THRESHOLD=12
RETREAT_DISTANCE=8
CREEPER_SAFE_DISTANCE=6
MELEE_RANGE=3.1
MELEE_APPROACH_DISTANCE=2.4

# Autonomous companion core
# Must be true for proactive conversation (including while following).
AUTONOMY_ENABLED=true
AUTONOMY_INTERVAL_MS=30000
AUTONOMY_EVENT_MIN_GAP_MS=10000
AUTONOMY_SPEECH_COOLDOWN_MS=60000
AUTONOMY_SPEECH_DEDUP_MS=300000
AUTONOMY_MAX_PLAYER_DISTANCE=16
AUTONOMY_WANDER_RADIUS=6
AUTONOMY_EXPLORE_RADIUS=12
AUTONOMY_SUMMARY_RANGE=12
AUTONOMY_RESOURCE_SCAN_RANGE=10

# Lightweight presence (does not call Ollama)
# One default companionship intention on arrival; STOP/FOLLOW always override.
AUTO_ACCOMPANY_ENABLED=true
AUTO_ACCOMPANY_DELAY_MS=3500
AUTO_ACCOMPANY_RANGE=16
PRESENCE_ENABLED=true
PRESENCE_INITIAL_MIN_MS=1200
PRESENCE_INITIAL_MAX_MS=3000
PRESENCE_INTERVAL_MIN_MS=10000
PRESENCE_INTERVAL_MAX_MS=22000
PRESENCE_WALK_TIMEOUT_MS=8000

# Stage 4 controlled learning experiment (disabled by default)
# Keep false for ordinary companionship: this controls the automatic spawn experiment.
# Explicit player-requested learning tasks remain available and pause autonomy while active.
LEARNING_ENABLED=false
LEARNING_START_DELAY_MS=5000
LEARNING_MAX_ACTIONS=20
LEARNING_MAX_DURATION_MS=180000
LEARNING_REPEAT_LIMIT=3
LEARNING_OBSERVATION_RANGE=8
LEARNING_EXPLORE_RADIUS=16
LEARNING_MOVE_TIMEOUT_MS=20000
LEARNING_MEMORY_FILE=learning-memory/memory.json

# Stage 4.2 local multimodal perception (Fabric pushes PNG frames to loopback)
VISION_ENABLED=false
VISION_BRIDGE_HOST=127.0.0.1
VISION_BRIDGE_PORT=32145
# Optional shared local token; use the same value in config/ai-companion-client.json.
VISION_BRIDGE_TOKEN=
VISION_MAX_FRAME_BYTES=2000000
VISION_MAX_WIDTH=1280
VISION_MAX_HEIGHT=720
VISION_FRAME_MAX_AGE_MS=15000
VISION_FRESH_FRAME_MS=5000
VISION_BACKGROUND_INTERVAL_MS=45000
VISION_BACKGROUND_COOLDOWN_MS=30000
VISION_EVENT_MIN_GAP_MS=15000
VISION_CHANGE_THRESHOLD=0.20
VISION_OBSERVATION_TTL_MS=30000
VISION_DEBUG_SAVE_FRAMES=false
VISION_DEBUG_MAX_FRAMES=5
VISION_DEBUG_DIRECTORY=vision-debug

# Empty/unset: randomly choose a greeting from config/spawn-greetings.json on join.
# Set a nonempty value only if you want a fixed custom greeting.
SPAWN_MESSAGE=
